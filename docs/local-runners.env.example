# Per-machine env for parity tests, fixture regen, and benchmarks.
#
# Setup:
#     cp docs/local-runners.env.example .claude/local-runners/.env
#     $EDITOR .claude/local-runners/.env
#
# Then `source .claude/local-runners/env.sh` and use `test.sh` /
# `regen-fixtures.sh` / `bench.sh` from `.claude/local-runners/`.
#
# `.claude/` is gitignored, so the resulting `.env` never leaves your
# machine. This file (`docs/local-runners.env.example`) is the only
# tracked copy.

# Path to the python reference repo (Depth-Anything-3)
DA3_PY_REPO=

# DA3 streaming weights (multi-view giant+large nested checkpoint)
DA3_STREAMING_WEIGHTS=
DA3_STREAMING_WEIGHTS_CONFIG=

# Single-image DA3 weights (any DA3-*-1.1 HuggingFace checkpoint) — used by
# ParityFixtureTests. Download:
#   curl -L -o model.safetensors \
#     https://huggingface.co/depth-anything/DA3-LARGE-1.1/resolve/main/model.safetensors
DA3_WEIGHTS=

# SALAD VPR weights (.ckpt + converted .safetensors)
DA3_SALAD_CKPT=
DA3_SALAD_WEIGHTS=
